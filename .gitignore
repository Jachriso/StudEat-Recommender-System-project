# ── Data files (too large for git) ───────────────────────────────────────────
data/raw/*
data/processed/*
data/*.db

# Keep the folder structure in git
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.py[cod]
*.pyo
.env
venv/
.venv/
*.egg-info/

data/
*.csv
*.parquet
*.pt

# ── Notebooks checkpoints ─────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
